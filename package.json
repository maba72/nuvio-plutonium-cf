{
  "name": "nuvio-plutonium-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker Nuvio addon for Pluto TV: catalogs, ad-free HLS, and subtitle resyncing.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
